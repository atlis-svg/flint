{"width":640.0,"height":400.0,"fps":30.0,"background":[24,28,40,255],"layers":[{"name":"Actions","visible":true,"locked":false,"outline":false,"color":[190,110,255,255],"len":30,"keys":{"0":{"shapes":[],"tween":{"kind":"None","ease":0.0,"spins":0},"label":"loop","script":""},"29":{"shapes":[],"tween":{"kind":"None","ease":0.0,"spins":0},"label":"","script":"goto_and_play(\"loop\");"}}},{"name":"Stage","visible":true,"locked":false,"outline":false,"color":[74,144,255,255],"len":30,"keys":{"0":{"shapes":[{"id":3,"geom":{"Rect":{"w":40.0,"h":40.0,"radius":6.0}},"xf":{"x":560.0,"y":90.0,"sx":1.0,"sy":1.0,"rot":0.0},"stroke":[255,255,255,255],"stroke_w":2.0,"fill":[90,220,120,255],"name":"goal","on_click":""},{"id":2,"geom":{"Ellipse":{"rx":22.0,"ry":22.0}},"xf":{"x":320.0,"y":200.0,"sx":1.0,"sy":1.0,"rot":0.0},"stroke":[255,255,255,255],"stroke_w":2.0,"fill":[255,90,90,255],"name":"hero","on_click":""},{"id":4,"geom":{"Rect":{"w":150.0,"h":44.0,"radius":10.0}},"xf":{"x":100.0,"y":360.0,"sx":1.0,"sy":1.0,"rot":0.0},"stroke":[255,255,255,255],"stroke_w":2.0,"fill":[60,110,230,255],"name":"button","on_click":"clicks += 1;\nhero.fill = [\"#ff5a5a\", \"#ffd23c\", \"#5ac8ff\", \"#c87aff\"][clicks % 4];\ntrace(`button clicked ${clicks} times`);"},{"id":5,"geom":{"Text":{"text":"Recolor","size":22.0}},"xf":{"x":58.0,"y":346.0,"sx":1.0,"sy":1.0,"rot":0.0},"stroke":null,"stroke_w":2.0,"fill":[255,255,255,255],"name":"label","on_click":""},{"id":6,"geom":{"Text":{"text":"Score: 0","size":24.0}},"xf":{"x":16.0,"y":12.0,"sx":1.0,"sy":1.0,"rot":0.0},"stroke":null,"stroke_w":2.0,"fill":[255,255,255,255],"name":"score","on_click":""},{"id":7,"geom":{"Text":{"text":"Arrow keys to move, reach the green box","size":16.0}},"xf":{"x":330.0,"y":16.0,"sx":1.0,"sy":1.0,"rot":0.0},"stroke":null,"stroke_w":2.0,"fill":[180,190,210,255],"name":"help","on_click":""}],"tween":{"kind":"None","ease":0.0,"spins":0},"label":"","script":""}}},{"name":"Spinner","visible":true,"locked":false,"outline":false,"color":[255,200,60,255],"len":30,"keys":{"0":{"shapes":[{"id":8,"geom":{"Rect":{"w":30.0,"h":30.0,"radius":0.0}},"xf":{"x":590.0,"y":340.0,"sx":1.0,"sy":1.0,"rot":0.0},"stroke":[255,255,255,255],"stroke_w":2.0,"fill":[255,200,60,255],"name":"spinner","on_click":""}],"tween":{"kind":"Classic","ease":0.0,"spins":1},"label":"","script":""},"29":{"shapes":[{"id":8,"geom":{"Rect":{"w":30.0,"h":30.0,"radius":0.0}},"xf":{"x":590.0,"y":340.0,"sx":1.0,"sy":1.0,"rot":0.0},"stroke":[255,255,255,255],"stroke_w":2.0,"fill":[255,200,60,255],"name":"spinner","on_click":""}],"tween":{"kind":"Classic","ease":0.0,"spins":1},"label":"","script":""}}}],"next_id":8,"script":"let hero = obj(\"hero\");\nlet clicks = 0;\nlet points = 0;\nlet speed = 6;\ntrace(\"movie started\");","on_frame":"if key_down(\"Left\") { hero.x -= speed; }\nif key_down(\"Right\") { hero.x += speed; }\nif key_down(\"Up\") { hero.y -= speed; }\nif key_down(\"Down\") { hero.y += speed; }\nhero.x = hero.x.max(22.0).min(stage_width() - 22.0);\nhero.y = hero.y.max(22.0).min(stage_height() - 22.0);\nif hero.hit_test(obj(\"goal\")) {\n    points += 1;\n    let sc = obj(\"score\");\n    sc.text = `Score: ${points}`;\n    let g = obj(\"goal\");\n    g.x = random_int(40, 600);\n    g.y = random_int(60, 300);\n}","on_key":"if key == \"Space\" { if is_playing() { stop(); } else { play(); } }"}